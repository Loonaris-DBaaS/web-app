generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql" // changez selon votre SGBD (postgresql, mysql, sqlite...)
  url      = env("DATABASE_URL")
}

model Tenant {
  id        Int        @id @default(autoincrement())
  databases Database[]
}

model Database {
  id                Int      @id @default(autoincrement())
  cluster_name      String?
  number_replicas   Int?
  namespace         String?
  region            String?
  storage_usage     Float?
  postgreSQL_v      String?
  max_connection    Int?
  enable_backup     Boolean  @default(false)
  enable_autoscale  Boolean  @default(false)
  status            String?
  CPU_usage         Float?
  API_Key           String?
  id_tenant         Int?
  tenant            Tenant?  @relation(fields: [id_tenant], references: [id], onDelete: Cascade, onUpdate: Cascade)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}
