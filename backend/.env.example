PORT=3001
JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me-refresh
# comma-separated list of allowed origins (e.g. for prod: https://app.loonaris.com,https://www.loonaris.com)
CORS_ORIGIN=http://localhost:5173

# Node environment — affects cookie `secure` flag (`production` = secure cookies)
NODE_ENV=development

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings
DATABASE_URL="postgresql://postgres:postgres@localhost:5436/postgres"

# Set to 'true' when connecting to RDS or any TLS-enabled Postgres. Local Docker Postgres usually has no certificate.
DATABASE_SSL=false
