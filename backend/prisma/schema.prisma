generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ProjectStatus {
  provisioning
  running
  stopped
  error
  deleting
}

model Tenant {
  id           String   @id @default(uuid())
  email        String   @unique
  username     String   @unique
  country      String?
  jobTitle     String?  @map("job_title")
  company      String?
  passwordHash String   @map("password_hash")
  isAdmin      Boolean  @default(false) @map("is_admin")
  photoUrl     String?  @map("photo_url")
  createdAt    DateTime @default(now()) @map("created_at")

  refreshTokens RefreshToken[]
  projects      Project[]

  @@map("tenant")
}

model RefreshToken {
  id        String    @id @default(uuid())
  token     String    @unique
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  tenantId String @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model Project {
  id               String           @id @default(uuid())
  name             String
  k8sNamespace     String           @unique @map("k8s_namespace")
  pgVersion        String           @map("pg_version")
  region           String
  estimatedPrice   Float            @default(0) @map("estimated_price")
  price            Float            @default(0)
  cpuUsage         Float            @default(0) @map("cpu_usage")
  ramUsage         Float            @default(0) @map("ram_usage")
  storageUsage     Float            @default(0) @map("storage_usage")
  status           ProjectStatus    @default(provisioning)
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  tenantId String @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  resourceConfig ResourceConfig?
  poolers        Pooler[]
  apiKeys        ApiKey[]

  @@map("projects")
}

model ResourceConfig {
  id              String   @id @default(uuid())
  instances       Int      @default(1)
  enableBackup    Boolean  @default(false) @map("enable_backup")
  enableAutoscale Boolean  @default(false) @map("enable_autoscale")
  enablePitr      Boolean  @default(false) @map("enable_pitr")
  desiredStorage  String   @map("desired_storage")
  desiredRam      String   @map("desired_ram")
  desiredCpu      String   @map("desired_cpu")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  projectId String  @unique @map("project_id")
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("resource_configs")
}

model Pooler {
  id     String @id @default(uuid())
  rwHost String @map("rw_host")
  rwPort Int    @default(5432) @map("rw_port")
  roHost String @map("ro_host")
  roPort Int    @default(5432) @map("ro_port")

  projectId String  @unique @map("project_id")
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("poolers")
}

model ApiKey {
  id        String    @id @default(uuid())
  keyHash   String    @unique @map("key_hash")
  prefix    String
  duration  Int
  createdAt DateTime  @default(now()) @map("created_at")
  revokedAt DateTime? @map("revoked_at")

  projectId String  @map("project_id")
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("api_keys")
}

model TestApp {
  id   Int    @id @default(autoincrement())
  name String

  @@map("test_apps")
}
